POSTGRES_DB=compliance
POSTGRES_USER=compliance
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://compliance:change_me@db:5432/compliance
JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:5173
API_PORT=4000
WEB_PORT=5173
VITE_API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# Must be an externally-reachable URL — GitHub's manifest/install redirects hit
# this directly. For local dev, front the API with a tunnel (e.g. ngrok) to
# exercise the real GitHub App flow end-to-end.
API_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@auditready.local
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
# Optional: override the default Claude model on Bedrock
# BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-8-20250514-v1:0


# Super Admin (platform-level account)
SUPERADMIN_EMAIL=superadmin@auditready.com
SUPERADMIN_PASSWORD=change_me

# Google Analytics 4 (Measurement ID)
VITE_GA_ID=G-*********

# Base64-encoded 32-byte key used to encrypt integration credentials at rest.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
