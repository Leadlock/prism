{
  "key": "aws",
  "title": "Amazon Web Services",
  "category": "cloud",
  "authTypes": ["access_key", "iam_role"],
  "tests": [
    { "testKey": "aws.iam.mfa_enforced", "title": "IAM users have MFA enabled", "severityDefault": "critical", "isoReferences": ["A.9.4.2"] },
    { "testKey": "aws.iam.password_policy", "title": "Account password policy meets minimum strength", "severityDefault": "high", "isoReferences": ["A.9.4.3"] },
    { "testKey": "aws.iam.access_key_age", "title": "IAM access keys are rotated within 90 days", "severityDefault": "high", "isoReferences": ["A.9.2.4"] },
    { "testKey": "aws.logging.cloudtrail_enabled", "title": "CloudTrail is enabled and multi-region", "severityDefault": "critical", "isoReferences": ["A.12.4.1"] },
    { "testKey": "aws.logging.config_enabled", "title": "AWS Config is recording", "severityDefault": "medium", "isoReferences": ["A.12.1.1"] },
    { "testKey": "aws.network.s3_public_access_blocked", "title": "S3 buckets block public access", "severityDefault": "critical", "isoReferences": ["A.8.2.3"] },
    { "testKey": "aws.network.security_groups_no_open_ingress", "title": "Security groups do not expose management ports publicly", "severityDefault": "critical", "isoReferences": ["A.13.1.1"] },
    { "testKey": "aws.rds.publicly_accessible", "title": "RDS instances are not publicly accessible", "severityDefault": "critical", "isoReferences": ["A.13.1.1"] },
    { "testKey": "aws.rds.storage_encrypted", "title": "RDS instances have storage encryption enabled", "severityDefault": "critical", "isoReferences": ["A.8.2.3"] },
    { "testKey": "aws.rds.automated_backups_enabled", "title": "RDS instances have automated backups enabled", "severityDefault": "high", "isoReferences": ["A.12.3.1"] },
    { "testKey": "aws.lambda.function_url_not_public", "title": "Lambda function URLs require authentication", "severityDefault": "critical", "isoReferences": ["A.13.1.1"] },
    { "testKey": "aws.lambda.no_wildcard_resource_policy", "title": "Lambda resource policies do not grant a wildcard principal", "severityDefault": "critical", "isoReferences": ["A.9.1.2"] },
    { "testKey": "aws.dynamodb.point_in_time_recovery_enabled", "title": "DynamoDB tables have point-in-time recovery enabled", "severityDefault": "high", "isoReferences": ["A.12.3.1"] },
    { "testKey": "aws.dynamodb.encryption_uses_cmk", "title": "DynamoDB tables are encrypted with a customer-managed key", "severityDefault": "medium", "isoReferences": ["A.8.2.3"] },
    { "testKey": "aws.kms.key_rotation_enabled", "title": "Customer-managed KMS keys have rotation enabled", "severityDefault": "high", "isoReferences": ["A.10.1.2"] },
    { "testKey": "aws.kms.no_wildcard_key_policy", "title": "KMS key policies do not grant a wildcard principal", "severityDefault": "critical", "isoReferences": ["A.9.1.2"] }
